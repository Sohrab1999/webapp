# Interactive English Learning Web App — environment template
#
# Copy this file to .env and adjust values locally.
# NEVER commit the real .env file; it is excluded via .gitignore.
# Keep this template free of real credentials — variable names and
# safe placeholder values only.

# Local SQLite database file used by the app (no credentials involved).
# Placeholder path — adjust to your local setup.
DATABASE_URL=file:./db/custom.db
